# Copy to .env.local and fill in. Never commit real secrets.

# ── Required ────────────────────────────────────────────────
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/designdojo"
GROQ_API_KEY="gsk_..."                       # server-only; never prefix with NEXT_PUBLIC_
JWT_SECRET=""                                # >= 32 random chars: openssl rand -base64 48
NEXTAUTH_SECRET=""                           # openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000" # public URL used for SEO, sitemap and emails

# ── Admin account (seeded on first DB connection) ───────────
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""                            # >= 12 chars; only used to create the account

# ── Optional: OAuth sign-in (providers are hidden unless both values are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""

# ── Optional: password-reset emails ─────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="DesignDojo <no-reply@example.com>"

# ── Optional: footer / structured-data links ────────────────
NEXT_PUBLIC_AUTHOR_GITHUB=""
NEXT_PUBLIC_AUTHOR_LINKEDIN=""
NEXT_PUBLIC_CONTACT_EMAIL=""
